# Owner panel (port 3085, 127.0.0.1 only). Copy to .env.local, or run `node scripts/make-env.mjs`
# from the repo root, which generates every secret below and the Ed25519 pair. Never commit .env.local.
OWNER_USERNAME=owner
OWNER_PASSWORD=
OWNER_SESSION_SECRET=
# Same value as OWNER_SHARED_SECRET in backend/.env
OWNER_SHARED_SECRET=
# Ed25519 private key; written by scripts/owner-keys.mjs (the public half goes to backend/.env)
OWNER_SIGNING_KEY=
SITE_KEY=hash-game-exchange
SITE_NAME=Hash Game Exchange
SITE_GATEWAY_URL=https://api.parker567.com
# Browser-facing API origin for assets the page loads directly (coin images).
SITE_PUBLIC_API_BASE=
SITE_ADMIN_URL=http://localhost:3080
SITE_FRONTEND_URL=http://localhost:5190
NEXT_PUBLIC_ENV_LABEL=localhost
PORT=3085
# Live only (build-time): the panel is served at admin.parker567.com/owner. Without it /owner falls through to the admin's /login.
# BASEPATH=/owner
# OWNER_DATA_DIR=   only for scripts/import-to-db.mjs and seed-plan.mjs (default owner-panel/data); the panel itself keeps nothing on disk

# The platform API (same name as frontend/.env.local)
NEXT_PUBLIC_API_BASE=https://api.parker567.com
