# Backend the Vite dev proxy forwards /api to (e.g. https://apitest.cfzautomation.com).
API_TARGET=

# LuckySports (JSGames V2) game uuid: the sportsbook /sports opens when Slotegrator is not configured.
VITE_SPORTSBOOK_GAME_UID=8a704858d5deb4af1ddc722092ac7614

# Sports exchange (shown when the owner has `sportsexchange` on). All optional.
# Gateway origin for the exchange's socket (/ws/sports/socket.io) when the host cannot proxy a
# websocket (Vercel rewrites); empty = same origin (the dev proxy). Without it odds fall back to polling.
VITE_SPORTS_SOCKET_URL=
# Live stream base (gmid appended), scorecard host and cricket score socket (ws:// or wss://); empty = hidden.
VITE_SPORTS_STREAM_BASE=
VITE_SCORECARD_BASE=
VITE_SCORE_SOCKET_URL=
