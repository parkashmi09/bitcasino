{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://apitest.cfzautomation.com/api/:path*" },
    { "source": "/health", "destination": "https://apitest.cfzautomation.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
