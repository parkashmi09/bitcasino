# Where this admin's platform gateway is (server-side only; the browser talks to /api/gw/*)
API_URL=https://api.parker567.com

# Identity of the site this admin build serves.
NEXT_PUBLIC_SITE_KEY=hash-game-exchange
NEXT_PUBLIC_SITE_NAME=Hash Game Exchange Admin
NEXT_PUBLIC_SITE_TAGLINE=Operator panel
NEXT_PUBLIC_ENV_LABEL=localhost

# Session cookie (httpOnly). 8h matches the platform's JWT_ADMIN_TTL.
SESSION_COOKIE_NAME=parker567_admin_token
SESSION_MAX_AGE_SECONDS=28800
PORT=3080

# The platform API (same name as frontend/.env.local)
NEXT_PUBLIC_API_BASE=https://api.parker567.com
